TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_CHAT_ID=your-numeric-chat-id-here

# Demo defaults
MONTHLY_BUDGET=1000
DATA_DIR=./data
# Local PaddleOCR 2.7.x pipeline. Keep Python at 3.11; PaddleOCR 3.x on
# Windows/CPU is known to hit oneDNN/PIR crashes in this project.
OCR_MODE=paddle
OCR_CONFIDENCE_WARN=0.75
TELEGRAM_PHOTO_MAX_PIXELS=1400000
MAX_AUTO_SAVE_AMOUNT=10000
TESSERACT_CMD=tesseract
TZ=Europe/Warsaw
